{
  "name": "rgaa-assistant",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "description": "RGAA 4.1 audit assistant for the browser DevTools: element-by-element review, automatic and manual checks, saved audits, Excel grid and printable report.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:asqatasun": "node scripts/check-asqatasun.mjs",
    "test": "vitest run",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check": "npm run typecheck && npm test && npm run check:i18n && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "1.64.0",
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "axe-core": "^4.14.0",
    "fflate": "^0.8.3",
    "html-validate": "^11.0.0"
  }
}
